# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Android/Play submission secrets.
#
# eas.json points submit.production.android at credentials/play-service-account.json.
# That file is a Google Cloud service-account PRIVATE KEY with release-manager rights on
# the Play listing — the existing rules above only cover *.p8/*.p12/*.jks, so a .json key
# would otherwise have been committed on the first `eas submit` setup.
credentials/*.json

# The Firebase FCM V1 service-account private key (uploaded to EAS, never to git).
firebase-service-account*.json
fcm-v1-*.json

# NOTE: google-services.json is deliberately NOT ignored. It holds only public
# identifiers, Expo needs it at build time via android.googleServicesFile, and EAS
# build workers get it from the repo — ignoring it silently breaks Android push.

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Supabase CLI cache
supabase/.temp/
.vercel
.env*

# Claude Code local (machine-specific) settings — keep out of the repo
.claude/settings.local.json

# Local seed manifest (test-user ids/emails, machine-local)
scripts/.seed/

# Next.js build output (web/ has its own ignore; this catches a stray build
# run from the repo root, which is how two trace files once got committed).
.next/
deno.lock
